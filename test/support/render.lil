// Test-only: markdown -> lil2 mdast -> lil2 hast -> React elements through the given runtime.
import { fromMarkdownTree } from "../../src/mdast/parse.lil";
import { keywordNames, propNames, tagNames } from "../../src/hast/hast.lil";
import { ToHast, installCommonmark, toHast } from "../../src/hast/to-hast.lil";
import { JsxOptions, componentTable, toJsxRuntime } from "../../src/jsx/to-jsx.lil";

// `components`: flat `[tag, component, ...]` pairs.
export JsValue render(string value, JsValue Fragment, JsValue jsx, JsValue jsxs, JsValue components, bool passNode) {
  ToHast state = new ToHast(fromMarkdownTree(value), false);
  installCommonmark(state);
  int root = toHast(state);
  JsxOptions options = new JsxOptions(Fragment, jsx, jsxs, componentTable(components));
  options.passNode = passNode;
  return toJsxRuntime(state.hast, root, options);
}

export { tagNames, propNames, keywordNames };
